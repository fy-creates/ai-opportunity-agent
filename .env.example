# Copy to .env for local development. Never commit .env itself.

# --- Core ---
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/opportunity_agent

# --- Adzuna source adapter (app/ingestion/adapters/adzuna.py) ---
# Register a free app_id/app_key at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional Adzuna tuning (defaults shown in app/config.py)
# ADZUNA_COUNTRY=us
# ADZUNA_WHAT=intern OR internship OR entry level
# ADZUNA_RESULTS_PER_PAGE=50
# ADZUNA_MAX_PAGES=3
